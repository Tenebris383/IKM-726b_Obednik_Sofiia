    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IReadOnlyList<SensorView>
@{
    ViewData["Title"] = "Мнемосхема";
    var uk = new System.Globalization.CultureInfo("uk-UA");
    DateTime today = DateTime.Today;
    DateTime first = new DateTime(today.Year, today.Month, 1);
    int offset = ((int)first.DayOfWeek + 6) % 7;
    int days = DateTime.DaysInMonth(today.Year, today.Month);
}
<h2>Мнемосхема гідроелектростанції</h2>
<div class="scada-page">
<div class="scheme">
@foreach (SensorView s in Model)
{
    <div class="sensor" data-topic="@s.Topic" data-min="@s.Min" data-max="@s.Max" style="left: @(s.X)px; top: @(s.Y)px;">
        <div class="name">@s.Name</div>
        <div class="value">-</div>
    </div>
}
</div>

<table class="cal">
<caption>@uk.TextInfo.ToTitleCase(today.ToString("MMMM yyyy", uk))
</caption>
<tr><th>Пн</th><th>Вт</th><th>Ср</th><th>Чт</th><th>Пт</th>
<th>Сб</th><th>Нд</th></tr>
<tr>
@for (int i = 0; i < offset; i++)
{
    <td></td>
}
@for (int d = 1; d <= days; d++)
{
    bool isWeekend = (offset + d - 1) % 7 >= 5;
    string css = d == today.Day ? "today" : (isWeekend ? "weekend" : "");
    <td class="@css">@d</td>
if ((offset + d) % 7 == 0)
{
    @:</tr><tr>
}
}
</tr>
</table>
</div>

<form method="post" asp-action="Save">
    <button class="btn btn-success mt-2">Зберегти покази</button>
</form>
@section Scripts
{
    <script src="~/js/scheme.js"> </script>
}